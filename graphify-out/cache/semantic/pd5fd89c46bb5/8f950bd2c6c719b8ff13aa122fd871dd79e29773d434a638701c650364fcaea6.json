{"nodes": [{"id": "claude_modular_architecture_rule", "label": "Modular Architecture Rule", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Logic must never collect in one file; UI, video, pose, skeleton, retargeting, export and Blender integration are separate modules."}, {"id": "claude_rig_independent_skeleton", "label": "Rig-Independent Skeleton Representation", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "AI keypoints must not depend on Blender bone names. An intermediate canonical skeleton sits between them so multiple detectors and multiple rigs are both supported."}, {"id": "claude_ui_ai_separation", "label": "UI / AI Logic Separation", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Keeping UI logic out of the AI and animation code is what lets the domain be tested headlessly and the UI be replaced."}, {"id": "claude_blender_isolation_rule", "label": "Blender Code Isolation", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Blender-specific code must never mix into the core application, so the app runs and tests without bpy installed."}, {"id": "claude_incremental_workflow", "label": "Incremental Development Workflow", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One feature at a time: analyse, explain the plan, implement, test, summarise. No unrequested features and no placeholder implementations."}], "edges": [{"source": "claude_rig_independent_ske