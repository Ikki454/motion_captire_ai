{"nodes": [{"id": "docs_architecture_four_level_pipeline", "label": "Four-Level Data Pipeline", "file_type": "rationale", "source_file": "docs/architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "L0 detector-native -> L1 canonical joints -> L2 canonical bone rotations -> L3 rig-named curves. Each level is owned by one layer so a new AI backend only touches L0->L1 and a new rig only touches L2->L3."}, {"id": "docs_architecture_layered_architecture", "label": "Lightweight Hexagonal Architecture", "file_type": "rationale", "source_file": "docs/architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "UI -> orchestration -> domain -> adapters. The domain stays pure Python and Qt-free so it is unit-testable without a UI; technical concerns (Qt, OpenCV, MediaPipe, Blender) live only at the edges."}, {"id": "docs_architecture_backend_plugin_system", "label": "Backend Plugin System", "file_type": "rationale", "source_file": "docs/architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Detectors and reconstructors are plugins behind stable interfaces, discovered via entry points. Swapping the AI must not require touching the rest of the app; unavailable backends stay listed with a human-readable reason."}, {"id": "docs_architecture_explicit_coordinate_conversion", "label": "Explicit Coordinate Conversion", "file_type": "rationale", "source_file": "docs/architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No module may convert coordinates silently. Conversions are named functions at named boundaries, so a wrong axis is a visible call site rather than a hidden sign flip."}, {"id": "docs_architecture_canonical_world_space", "label": "Canonical World Space (Y-up)", "file_type": null, "source_file": "docs/architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_non_blocking_ui", "label": "Non-Blocking UI", "file_type": "rationale", "source_file": "docs/architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Video analysis must never run on the Qt main thread. Long work goes through a Qt-free TaskManager whose callbacks fire on the worker thread; the UI marshals them back with Qt signals."}, {"id": "docs_architecture_rig_name_independence", "label": "Rig Name Independence", "file_type": "rationale", "source_file": "docs/architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No code path references a specific rig's bone names. Supporting a new rig is a data task (drop in a profile), which is what makes custom rigs possible at all."}, {"id": "docs_architecture_adr_table", "label": "Architecture Decision Records", "file_type": "document", "source_file": "docs/architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_architecture_four_level_pipeline", "target": "docs_data_model_level0_raw_pose", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/architecture.md", "source_location": null, "weight": 1.0}, {"source": "docs_architecture_four_level_pipeline", "target": "docs_data_model_level3_rig_clip", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/architecture.md", "source_location": null, "weight": 1.0}, {"source": "docs_architecture_explicit_coordinate_conversion", "target": "app_math_coordinates_coordinatespace", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_